{
  "name": "ufcfantasy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ufc-fantasy",
      "database_id": "YOUR_ACTUAL_UUID_HERE"
    }
  ]
}
